{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          }
        },
        "appVersion": { "type": "string" },
        "workerCommand": {
          "type": "object",
          "properties": {
            "useWrapper": { "type": "boolean" },
            "binary": { "type": "string" }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "service": { "$ref": "#/definitions/service" },
        "progressDeadlineSeconds": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "startupProbe": { "$ref": "#/definitions/singleSuccessProbeOverride" },
        "readinessProbe": { "$ref": "#/definitions/probeOverride" },
        "livenessProbe": { "$ref": "#/definitions/singleSuccessProbeOverride" },
        "octane": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "workers": {
              "anyOf": [
                { "type": "integer", "minimum": 1 },
                { "type": "string" }
              ]
            },
            "logLevel": { "type": "string" },
            "extraArgs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "autoscaling": { "$ref": "#/definitions/autoscaling" }
      }
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "type": {
            "type": "string",
            "enum": ["queue", "horizon", "scheduler", "combined"]
          },
          "enabled": { "type": "boolean" },
          "replicas": { "type": "integer", "minimum": 1 },
          "queue": { "type": "string" },
          "queueOptions": {
            "type": "object",
            "properties": {
              "sleep": { "type": ["integer", "null"], "minimum": 0 },
              "tries": { "type": ["integer", "null"], "minimum": 0 },
              "timeout": { "type": ["integer", "null"], "minimum": 0 },
              "maxTime": { "type": ["integer", "null"], "minimum": 0 },
              "memory": { "type": ["integer", "null"], "minimum": 0 },
              "backoff": { "type": ["integer", "null"], "minimum": 0 }
            }
          },
          "autoscaling": { "$ref": "#/definitions/workerAutoscaling" }
        }
      }
    },
    "reverb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "service": { "$ref": "#/definitions/service" },
        "autoscaling": { "$ref": "#/definitions/autoscaling" }
      }
    },
    "routing": {
      "type": "object",
      "properties": {
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["service", "host", "paths"],
                "properties": {
                  "service": { "type": "string", "enum": ["app", "reverb"] },
                  "host": { "type": "string" },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": { "type": "string" },
                        "pathType": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
            ,
            "tls": {
              "type": "array",
              "items": {
                "anyOf": [
                  { "type": "string" },
                  {
                    "type": "object",
                    "required": ["hosts"],
                    "properties": {
                      "hosts": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "secretName": { "type": "string" }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "singleSuccessProbeOverride": {
      "allOf": [
        { "$ref": "#/definitions/probeOverride" },
        { "properties": { "successThreshold": { "const": 1 } } }
      ]
    },
    "probeOverride": {
      "anyOf": [
        { "type": "null" },
        { "const": false },
        { "$ref": "#/definitions/probe" }
      ]
    },
    "probePort": {
      "anyOf": [
        { "type": "integer", "minimum": 1, "maximum": 65535 },
        { "type": "string", "minLength": 1 }
      ]
    },
    "probe": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "exec": {
          "type": "object",
          "required": ["command"],
          "properties": {
            "command": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "httpGet": {
          "type": "object",
          "required": ["port"],
          "properties": {
            "path": { "type": "string" },
            "port": { "$ref": "#/definitions/probePort" },
            "host": { "type": "string" },
            "scheme": { "enum": ["HTTP", "HTTPS"] },
            "httpHeaders": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "value"],
                "properties": { "name": { "type": "string" }, "value": { "type": "string" } }
              }
            }
          }
        },
        "tcpSocket": {
          "type": "object",
          "required": ["port"],
          "properties": { "port": { "$ref": "#/definitions/probePort" }, "host": { "type": "string" } }
        },
        "grpc": {
          "type": "object",
          "required": ["port"],
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "service": { "type": "string" }
          }
        }
      },
      "allOf": [
        { "not": { "required": ["exec", "httpGet"] } },
        { "not": { "required": ["exec", "tcpSocket"] } },
        { "not": { "required": ["exec", "grpc"] } },
        { "not": { "required": ["httpGet", "tcpSocket"] } },
        { "not": { "required": ["httpGet", "grpc"] } },
        { "not": { "required": ["tcpSocket", "grpc"] } }
      ]
    },
    "service": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "type": "string" },
        "port": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 65535 },
            { "type": "null" }
          ]
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "targetMemoryUtilizationPercentage": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        }
      }
    },
    "workerAutoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["hpa", "keda"] },
        "minReplicas": { "type": "integer", "minimum": 0 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "targetMemoryUtilizationPercentage": {
          "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "targetValue": { "type": "integer", "minimum": 1 },
        "cooldownPeriod": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        }
      }
    }
  }
}
